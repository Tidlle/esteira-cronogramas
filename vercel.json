{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": {
      "memory": 2048,
      "maxDuration": 60,
      "includeFiles": "{templates/**,assets/**,modelos/**,node_modules/@sparticuz/chromium/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    }
  ]
}
